{
  "name": "@yukariyukaro/bilibili-cli",
  "version": "2.1.0",
  "description": "独立 B 站命令行工具：搜索、视频与字幕、评论、用户、私信、写入审计与 bridge 监听",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukariyukaro/bilibili-cli.git",
    "directory": "packages/bilibili-cli"
  },
  "homepage": "https://github.com/yukariyukaro/bilibili-cli",
  "bugs": {
    "url": "https://github.com/yukariyukaro/bilibili-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "bilibili": "./dist/cli/bili.mjs"
  },
  "files": [
    "dist",
    "cli",
    "SKILL.md",
    "references",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/verify.mjs",
    "build": "node scripts/build.mjs",
    "compile": "node scripts/compile.mjs",
    "typecheck": "tsc --noEmit",
    "test:release": "node test/release/run.mjs",
    "test:release:check": "node test/release/run.mjs --check",
    "test:release:docker": "node test/release/run.mjs --docker",
    "prepack": "node scripts/compile.mjs"
  },
  "dependencies": {
    "@yukariyukaro/bilibili-api-ts": "^17.5.0",
    "commander": "^14.0.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "~5.9.3"
  }
}
