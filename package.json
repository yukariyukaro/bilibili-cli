{
  "name": "bilibili-cli-repo",
  "version": "1.0.0",
  "private": true,
  "description": "B 站 CLI 与 Agent Skill monorepo；npm 包位于 packages/bilibili-cli",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node packages/bilibili-cli/scripts/build.mjs",
    "test": "node packages/bilibili-cli/scripts/verify.mjs",
    "test:bridge": "node packages/bilibili-cli/scripts/verify.mjs",
    "test:bridge:readonly": "node packages/bilibili-cli/test/bridge/e2e/run.mjs readonly",
    "test:bridge:write": "node packages/bilibili-cli/test/bridge/e2e/run.mjs write",
    "test:bridge:docker": "node packages/bilibili-cli/test/bridge/docker/run.mjs",
    "typecheck": "npm --prefix packages/bilibili-cli run typecheck",
    "pack:cli": "npm --prefix packages/bilibili-cli pack"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10"
}
